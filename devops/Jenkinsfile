pipeline {
    agent any 

    environment {
        AWS_REGION          = 'eu-central-1'
        AWS_ACCOUNT_ID      = '908456387091'
        BACKEND_REPOSITORY  = 'teachua-backend'
        FRONTEND_REPOSITORY = 'teachua-frontend'
        ECS_CLUSTER         = 'teachua-modular-cluster'
        ECS_SERVICE         = 'teachua-app-service'
        GITHUB_TOKEN        = sh(script: "aws ssm get-parameter --name '/teachua/cicd/github_pat' --with-decryption --query 'Parameter.Value' --output text --region eu-central-1", returnStdout: true).trim()

    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Push Backend') {
            steps {
                script {
                    
                    sh "aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
                                        
                    dir('backend') {
                        
                        sh "docker build --no-cache -t ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${BACKEND_REPOSITORY}:latest ."
                        sh "docker push ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${BACKEND_REPOSITORY}:latest"
                    }
                }
            }
        }

        stage('Build & Push Frontend') {
            steps {
                script {
                    dir('frontend') {
                        
                        sh "docker build -t ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${FRONTEND_REPOSITORY}:latest ."
                        sh "docker push ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${FRONTEND_REPOSITORY}:latest"
                    }
                }
            }
        }

        stage('Deploy to ECS') {
            steps {
                script {
                    sh """
                    aws ecs update-service \
                      --cluster ${ECS_CLUSTER} \
                      --service ${ECS_SERVICE} \
                      --force-new-deployment \
                      --region ${AWS_REGION}
                    """
                }
            }
        }
    }
}
