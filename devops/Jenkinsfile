pipeline {
    agent any

    // Глобальні змінні оточення для конфігурації Ansible
    environment {
        INVENTORY_FILE = 'devops/Ansible/hosts.ini'
        PLAYBOOK_FILE  = 'devops/Ansible/playbook.yml'
        SSH_CRED_ID    = 'target-servers-ssh-key'
    }

    stages {
        // Завантаження коду з GitHub
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // Сканування та аналіз безпеки коду в SonarCloud
        stage('SonarCloud Analysis') {
            steps {
                // Витягуємо збережений токен із Credentials Jenkins
                withCredentials([string(credentialsId: 'sonarcloud-token', variable: 'SONAR_TOKEN')]) {
                    script {
                        // Jenkins автоматично готує сканер із системних налаштувань Tools
                        def scannerHome = tool name: 'sonar-scanner', type: 'hudson.plugins.sonar.SonarRunnerInstallation'
                        
                        // Загортаємо виконання у блок з явним прокиданням змінної оточення
                        withEnv(["SONAR_TOKEN=${env.SONAR_TOKEN}"]) {
                            sh "${scannerHome}/bin/sonar-scanner -Dsonar.projectKey=dima19-93_Teach_ua -Dsonar.organization=dima19-93 -Dsonar.sources=. -Dsonar.host.url=https://sonarcloud.io -Dsonar.token=${env.SONAR_TOKEN} -Dsonar.exclusions='**/node_modules/**,**/target/**,**/dist/**,**/.cache/**,devops/**'"
                        }
                    }
                }
            }
        }
     
        
        stage('Build Docker Image') {
            steps {
                echo '=== Building Production Docker Image ==='
                sh "docker build -t dima70593/teach-ua-frontend:${env.BUILD_NUMBER} ./frontend"
                sh "docker build -t dima70593/teach-ua-backend:${env.BUILD_NUMBER} ./backend"
            }
        }

        
        stage('Trivy Security Scanning') {
            steps {
                echo '=== Scanning Docker Image with Trivy ==='
                sh "trivy image --severity HIGH,CRITICAL --exit-code 0 dima70593/teach-ua-frontend:${env.BUILD_NUMBER}"
                sh "trivy image --severity HIGH,CRITICAL --exit-code 0 dima70593/teach-ua-backend:${env.BUILD_NUMBER}"
            }
        }
  
        
        stage('Push Image to Docker Hub') {
            steps {
                echo '=== Logging in and Pushing Image to Registry ==='
                withCredentials([usernamePassword(credentialsId: 'docker-hub-creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    sh 'echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin'
                    sh "docker push dima70593/teach-ua-frontend:${env.BUILD_NUMBER}"
                    sh "docker push dima70593/teach-ua-backend:${env.BUILD_NUMBER}"
                }
            }
        }

        // Перевірка синтаксису плейбуків Ansible перед деплоєм
        stage('Ansible Lint & Syntax Check') {
            steps {
                sh "ansible-playbook -i ${env.INVENTORY_FILE} ${env.PLAYBOOK_FILE} --syntax-check"
            }
        }

        // Безпечне розгортання секретів та запуск деплою через Ansible
        stage('Ansible Deploy') {
            steps {
                // Одночасно витягуємо Secret file (конфіг) та Secret text (пароль sudo)
                withCredentials([
                    file(credentialsId: 'ansible-vars-file', variable: 'VARS_FILE_PATH'),
                    string(credentialsId: 'sudo-password', variable: 'SUDO_PASS'),
                    usernamePassword(credentialsId: 'docker-hub-creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')
                ]) {
                    script {
                        // Налаштування поведінки Ansible всередині раннера
                        env.ANSIBLE_HOST_KEY_CHECKING = 'False'
                        env.ANSIBLE_ROLES_PATH        = 'devops/Ansible/roles'
                        
                        // Створюємо цільову директорію для групових змінних
                        sh "mkdir -p devops/Ansible/group_vars/all"
                        
                        // Копіюємо секретний файл із тимчасової папки Jenkins у структуру Ansible
                        sh "cp \${VARS_FILE_PATH} devops/Ansible/group_vars/all/vars.yml"
                    }

                    // Запуск плейбука з передачею паролів та метаданих збірки
                    ansiblePlaybook(
                        playbook: "${env.PLAYBOOK_FILE}",
                        inventory: "${env.INVENTORY_FILE}",
                        credentialsId: "${env.SSH_CRED_ID}",
                        vaultCredentialsId: 'ansible-vault-password', // ID пароля від Ansible Vault
                        extraVars: [
                            "jenkins_build_num": "${env.BUILD_NUMBER}",
                            "jenkins_job_name" : "${env.JOB_NAME}",
                            "deploy_env"       : "production",
                            "ansible_become_password": "${SUDO_PASS}", // Пароль для виконання become: true
                            // Прокидаємо креди Docker Hub безпосередньо в Ansible плейбук
                            "docker_hub_username": "${DOCKER_USER}",
                            "docker_hub_password": "${DOCKER_PASS}"
                        ]
                    )
                }
            }
        }
    }

    // Пост-дії: очищення робочого простору після будь-якого результату збірки
    post {
        always {
            cleanWs() // Видаляє тимчасові файли та копії секретів з диска раннера
        }
    }
}

